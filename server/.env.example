PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/stick-reels
CLIENT_URL=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application)
# Authorized redirect URI: http://localhost:5000/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/callback

# Path to uv if it is not on PATH
# UV_BIN=C:\Users\you\.local\bin\uv.exe

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<your-domain>/api/billing/webhook, events subscription.*
RAZORPAY_WEBHOOK_SECRET=

# Set to true when the site is served over HTTPS
SECURE_COOKIES=false
